{
  "name": "pa-social",
  "version": "0.1.0",
  "private": true,
  "description": "Republication automatique des articles Passion Aquitaine en carrousel Instagram",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "smoke": "node --env-file=.env scripts/smoke-ig.mjs",
