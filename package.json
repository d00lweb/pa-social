    "meta:check": "node --env-file=.env scripts/meta-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "basic-ftp": "^5.3.1",
    "fast-xml-parser": "^5.2.0",
