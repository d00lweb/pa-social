      "guid": "https://passion-aquitaine.ouest-france.fr/?p=36266",
      "titre": "Truffe du Périgord : la France en importe plus qu’elle n’en récolte",
      "lien": "https://passion-aquitaine.ouest-france.fr/truffe-perigord-france-importe-plus-recolte/",
      "at": "2026-11-22T17:31:32.398Z",
      "reseaux": {
        "threads": {
          "texte": "Imaginez un marché aux truffes du Périgord, le parfum qui monte des paniers… Sauf qu’une bonne part des truffes vendues en France n’a jamais poussé ici. Le pays en importe 127 tonnes, surtout d’Italie et de Bulgarie, pour seulement 75 tonnes récoltées. Un drôle de paradoxe pour une terre aussi attachée à son diamant noir 🌳",
          "image": "https://passion-aquitaine.ouest-france.fr/social/20261122-ecd6c5a6-th.jpg",
          "mode": "reponse",
          "reponse": "📍 L'histoire complète : https://passion-aquitaine.ouest-france.fr/truffe-perigord-france-importe-plus-recolte/",
          "sujet": "Périgord",
          "publieLe": "2026-11-22T10:16:02.757Z"
        },
        "x": {
          "texte": "🔍 Comment le pays de la truffe du #Périgord peut-il en importer plus qu’il n’en récolte ? 127 tonnes achetées, surtout en Italie et en Bulgarie, pour 75 tonnes produites en France.",
          "image": "https://passion-aquitaine.ouest-france.fr/social/20261122-ecd6c5a6-x.jpg",
          "mode": "reponse",
          "reponse": "👉 Tous les détails : https://passion-aquitaine.ouest-france.fr/truffe-perigord-france-importe-plus-recolte/",
          "sujet": null,
          "publieLe": "2026-11-22T11:00:47.144Z"
        },
        "bluesky": {
          "texte": "Le #Périgord a beau être sa terre d’élection, la France importe plus de truffes qu’elle n’en récolte ⚖️ 127 tonnes achetées, surtout en Italie et en Bulgarie, contre 75 tonnes sorties du sol français.",
          "image": "https://passion-aquitaine.ouest-france.fr/social/20261122-ecd6c5a6-bsky.jpg",
          "mode": "card",
          "reponse": null,
          "sujet": null,
          "publieLe": "2026-11-22T17:31:32.398Z"
        }
      }
    },
