      "guid": "https://passion-aquitaine.ouest-france.fr/?p=35626",
      "titre": "Des trimarans à nos mezzanines, ces filets sont cousus à Bordeaux",
      "lien": "https://passion-aquitaine.ouest-france.fr/des-trimarans-a-nos-mezzanines-ces-filets-sont-cousus-a-bordeaux/",
      "at": "2026-09-24T12:30:13.883Z",
      "reseaux": {
        "bluesky": {
          "texte": "Aux Bassins à flot, à #Bordeaux, des couturières assemblent les filets qui équipent les trimarans de course. Les mêmes gestes servent à fabriquer des filets sur-mesure pour les mezzanines des maisons, taillés au centimètre près 🪢",
          "image": "https://passion-aquitaine.ouest-france.fr/social/20260924-860ea888-bsky.jpg",
          "mode": "reply",
          "reponse": "📖 L'article complet : https://passion-aquitaine.ouest-france.fr/des-trimarans-a-nos-mezzanines-ces-filets-sont-cousus-a-bordeaux/",
          "sujet": null,
          "publieLe": "2026-09-24T10:12:15.872Z"
        },
        "x": {
          "texte": "Le filet tendu sous un trimaran de course et celui d’une mezzanine peuvent sortir du même atelier 🪡 Aux Bassins à flot, à #Bordeaux, des couturières les assemblent sur-mesure, du large au salon.",
          "image": "https://passion-aquitaine.ouest-france.fr/social/20260924-860ea888-x.jpg",
          "mode": "reponse",
          "reponse": "📖 L'article complet : https://passion-aquitaine.ouest-france.fr/des-trimarans-a-nos-mezzanines-ces-filets-sont-cousus-a-bordeaux/",
          "sujet": null,
          "publieLe": "2026-09-24T11:20:47.689Z"
        },
        "threads": {
          "texte": "🧵 On croit les filets de course réservés aux bateaux du large. En réalité, ceux des trimarans sont cousus aux Bassins à flot, à Bordeaux, par des couturières qui fabriquent aussi les filets tendus au-dessus de nos mezzanines. Même matière, même exigence, deux usages très différents. Vous connaissiez cet atelier ?",
          "image": "https://passion-aquitaine.ouest-france.fr/social/20260924-860ea888-th.jpg",
          "mode": "reponse",
          "reponse": "👉 Tous les détails : https://passion-aquitaine.ouest-france.fr/des-trimarans-a-nos-mezzanines-ces-filets-sont-cousus-a-bordeaux/",
          "sujet": "Bordeaux",
          "publieLe": "2026-09-24T12:30:13.883Z"
        }
      }
